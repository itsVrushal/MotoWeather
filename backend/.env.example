# Copy this file to .env and adjust values as needed

# OSRM local server (Docker)
OSRM_BASE_URL=http://localhost:5000

# Open-Meteo (no key needed, but URL configurable)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Nominatim (OSM geocoding)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Overpass (OSM POI queries)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Routing defaults
SAMPLE_INTERVAL_KM=25
PITSTOP_BUFFER_M=5000

# Optimizer weights (must sum to 1.0)
WEIGHT_RAIN=0.6
WEIGHT_WIND=0.3
WEIGHT_DELAY=0.1

# Departure window defaults
WINDOW_MINUTES=90
WINDOW_STEP_MINUTES=15

# Rider defaults
DEFAULT_AVG_SPEED_KMH=60.0
DEFAULT_TANK_RANGE_KM=300.0
